# ==============================================================================
# GRAIN SANDBOX EXPERIMENT DATA SERVER CONFIGURATION
# ==============================================================================

# Port & Host server web
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Path ke file Google Service Account JSON (ditaruh di folder root proyek)
GDRIVE_SERVICE_ACCOUNT_JSON=credentials.json

# ID Folder Induk (Root) Google Drive tempat data eksperimen disimpan
# Contoh: Jika URL folder https://drive.google.com/drive/folders/1aBcDeFgHiJkLmNoPqRsTuVwXyZ
# Maka ID-nya adalah: 1aBcDeFgHiJkLmNoPqRsTuVwXyZ
GDRIVE_ROOT_FOLDER_ID=

# PIN Keamanan untuk Tombol Sinkronisasi / Pengaturan Admin (Default: 123456)
ADMIN_PIN=123456

# Nama Lab / Judul Portal Web
PORTAL_TITLE="GRAIN Sandbox Experiment Data Server"
PORTAL_SUBTITLE="Analog Geological & Tectonic Modeling Video/Photo Catalog"
